<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>

    <AssemblyName>Druglord</AssemblyName>
    <RootNamespace>Druglord</RootNamespace>
    <Version>0.9.0</Version>
    <AssemblyVersion>0.9.0.0</AssemblyVersion>
    <FileVersion>0.9.0.0</FileVersion>

    <RepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\'))</RepositoryRoot>
    <ModuleId>Druglord</ModuleId>
    <ModuleOutputPath>$(RepositoryRoot)\artifacts\$(ModuleId)\</ModuleOutputPath>
    <OutputPath>$(ModuleOutputPath)bin\Win64_Shipping_Client\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    <Deterministic>true</Deterministic>
    <DebugType>embedded</DebugType>
    <PathMap>$(RepositoryRoot)=/_/</PathMap>

    <BannerlordGameDir Condition="'$(BannerlordGameDir)' == ''">$(BANNERLORD_GAME_DIR)</BannerlordGameDir>
    <BannerlordBinDir>$(BannerlordGameDir)\bin\Win64_Shipping_Client</BannerlordBinDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.3.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(BannerlordBinDir)\TaleWorlds.MountAndBlade.dll')">
    <Reference
      Include="$(BannerlordBinDir)\TaleWorlds.*.dll"
      Exclude="$(BannerlordBinDir)\TaleWorlds.Native.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(BannerlordGameDir)\Modules\Native\bin\Win64_Shipping_Client\*.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(BannerlordGameDir)\Modules\SandBox\bin\Win64_Shipping_Client\*.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(BannerlordGameDir)\Modules\StoryMode\bin\Win64_Shipping_Client\*.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(BannerlordGameDir)\Modules\CustomBattle\bin\Win64_Shipping_Client\*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateBannerlordPath" BeforeTargets="ResolveReferences">
    <Error
      Condition="'$(BannerlordGameDir)' == ''"
      Text="Set BannerlordGameDir in Directory.Build.props.user or set BANNERLORD_GAME_DIR." />
    <Error
      Condition="!Exists('$(BannerlordBinDir)\TaleWorlds.MountAndBlade.dll')"
      Text="Bannerlord assemblies were not found under '$(BannerlordBinDir)'." />
  </Target>

  <Target Name="CopyModuleFiles" AfterTargets="Build">
    <Delete Files="$(OutputPath)$(AssemblyName).pdb" />
    <ItemGroup>
      <ModuleSourceFiles Include="$(MSBuildProjectDirectory)\_Module\**\*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(ModuleSourceFiles)"
      DestinationFiles="@(ModuleSourceFiles->'$(ModuleOutputPath)%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>

  <Target Name="Deploy" DependsOnTargets="Build">
    <Error
      Condition="!Exists('$(BannerlordGameDir)\Modules')"
      Text="Bannerlord Modules directory was not found at '$(BannerlordGameDir)\Modules'." />
    <ItemGroup>
      <PublishedAssetPackages Include="$(ModuleOutputPath)AssetPackages\*.tpac" />
      <RuntimeModuleFiles
        Include="$(ModuleOutputPath)**\*"
        Exclude="$(ModuleOutputPath)Assets\**\*;$(ModuleOutputPath)AssetSources\**\*;$(ModuleOutputPath)RuntimeDataCache\**\*;$(ModuleOutputPath)AssetPackages\.gitkeep" />
    </ItemGroup>
    <Error
      Condition="'@(PublishedAssetPackages)' == ''"
      Text="Deployment requires a published TPAC under '$(ModuleOutputPath)AssetPackages'." />
    <RemoveDir Directories="$(BannerlordGameDir)\Modules\$(ModuleId)" />
    <Copy
      SourceFiles="@(RuntimeModuleFiles)"
      DestinationFiles="@(RuntimeModuleFiles->'$(BannerlordGameDir)\Modules\$(ModuleId)\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
    <Message
      Importance="high"
      Text="Clean-deployed $(ModuleId) runtime files to '$(BannerlordGameDir)\Modules\$(ModuleId)'." />
  </Target>

  <Target Name="DeployEditor" DependsOnTargets="Deploy">
    <ItemGroup>
      <EditorAssetFiles Include="$(MSBuildProjectDirectory)\_Module\Assets\**\*" />
      <EditorSourceFiles Include="$(MSBuildProjectDirectory)\_Module\AssetSources\**\*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(EditorAssetFiles)"
      DestinationFiles="@(EditorAssetFiles->'$(BannerlordGameDir)\Modules\$(ModuleId)\Assets\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
    <Copy
      SourceFiles="@(EditorSourceFiles)"
      DestinationFiles="@(EditorSourceFiles->'$(BannerlordGameDir)\Modules\$(ModuleId)\AssetSources\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
    <Exec
      Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\tools\stage-bannerlord-editor.ps1&quot; -RepositoryRoot &quot;$(MSBuildProjectDirectory)\..\..&quot; -InstalledModulePath &quot;$(BannerlordGameDir)\Modules\$(ModuleId)&quot;" />
    <Message
      Importance="high"
      Text="Prepared $(ModuleId) editor authoring dependencies." />
  </Target>

</Project>
